# ===============================================
# Configuración del Entorno - TurnoClínica / E-Commerce API
# ===============================================

# Servidor HTTP
PORT=3006
NODE_ENV=development

# Base de Datos PostgreSQL
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5437
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword
DB_NAME=ecommerce_db

# Redis (Caché, Rate Limit y Colas BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=ecommerce_super_jwt_secret_dev_2026_change_in_prod
JWT_EXPIRES_IN=1h

# Cloudinary (Almacenamiento de imágenes)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI (Recomendaciones y Búsqueda Semántica)
GEMINI_API_KEY=your_gemini_api_key_here

# SMTP / Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="E-Commerce Store <no-reply@ecommerce.com>"
